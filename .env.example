# =============================================================================
# 環境変数設定ファイル（テンプレート）
# =============================================================================
# このファイルをコピーして `.env` という名前で保存し、各変数を設定してください。
#   cp .env.example .env
#
# `.env` ファイルは Git の管理対象外です（.gitignore に登録済み）。
# 機密情報を含む変数は、絶対にリポジトリにコミットしないでください。
# =============================================================================

# -----------------------------------------------------------------------------
# アプリケーション基本設定
# -----------------------------------------------------------------------------

# アプリケーション名
# 例: my-app
APP_NAME=

# 実行環境
# 指定可能な値: development / staging / production
APP_ENV=development

# アプリケーションが使用するポート番号
# 例: 8080
APP_PORT=8080

# アプリケーションのベースURL
# 例: http://localhost:8080
APP_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# データベース設定
# -----------------------------------------------------------------------------

# データベースホスト名
# 例: localhost
DB_HOST=localhost

# データベースポート番号
# 例: 5432 (PostgreSQL) / 3306 (MySQL)
DB_PORT=5432

# データベース名
# 例: myapp_db
DB_NAME=

# データベースユーザー名
# 例: myapp_user
DB_USER=

# データベースパスワード（機密情報）
DB_PASSWORD=

# -----------------------------------------------------------------------------
# 認証・セキュリティ設定
# -----------------------------------------------------------------------------

# セッションやトークンの署名に使用するシークレットキー（機密情報）
# 十分に長くランダムな文字列を設定してください（例: openssl rand -hex 32 で生成）
SECRET_KEY=

# トークンの有効期限（秒）
# 例: 3600 (1時間)
TOKEN_EXPIRE_SECONDS=3600

# -----------------------------------------------------------------------------
# ログ設定
# -----------------------------------------------------------------------------

# ログの出力レベル
# 指定可能な値: DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO

# ログファイルの出力先ディレクトリ（空の場合は標準出力のみ）
# 例: ./logs
LOG_DIR=
